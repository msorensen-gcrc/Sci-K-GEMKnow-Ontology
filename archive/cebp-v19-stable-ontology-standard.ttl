    owl:hasSelf true
  ] ;
  rdfs:comment "Class to categorize \"applications\" resources for the Science Translator site page." .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/canadianGovernment>
  a owl:Class ;
