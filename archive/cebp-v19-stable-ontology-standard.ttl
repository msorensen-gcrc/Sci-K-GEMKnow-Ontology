  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture//DataProcessingAndEducation> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#NationalMarineConservationArea>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/GeoLocation> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#NorthernIndigneousCommunities>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/IndigenousCommunity> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#OnlineGenomicsCourse>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/GenomicsTools>, [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/isInformedBy> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/GenomicsMethod>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#isProvidedBy> ;
    owl:hasValue <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#ThreatenedSpeciesInitiative>
  ] .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#ProvincialPark>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/GeoLocation> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#http://purl.org/dc/terms/rightsHolder>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/IndigenousPartners> ;
  rdfs:label "rightsholder"@en ;
  skos:definition """This term refers to the fact that Indigenous Peoples are “rights and title holders.”
Indigenous Peoples’ constitutionally protected rights allow them to bind up a project in a legal process.
Indigenous communities are not mere stakeholders, they are rights-holders.""" .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/AcademicInstitution>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/Producers> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/BiogenomeDataAndProcess>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/provides> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ReferenceGenome>
  ] ;
  dc:description "Canada BioGenome Project (www.biogenome.ca), which has the aim of producing annotated genomes for approximately 400 Canadian species that are of cultural, conservation, scientific, and/or economic significance. Having a reference genome available increases the opportunities to incorporate genomic data into Species conservation." ;
  rdfs:isDefinedBy "Species of interest within the scope of the CEBP and the genomics data acquired through the CEBP for distribution and use - types of species and types of databases belong in this Class." .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/CommitteeMember>
  a owl:Class ;
  rdfs:subClassOf <http://www.w3.org/2000/10/swap/pim/contact#Person> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/CommunityScholar>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/IndigenousPartners> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/Company>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/Consumers>, <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture//Actor> ;
  dc:description "An Actor that is neither a Consumer nor Producer, but a grop, typically for-proft, working toward conservation, stewardship, and/or genomics-informed interventions for the flourishing of species diversity, biodiversity, and socio-ecological systems." ;
  rdfs:label "Company" .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationArea>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/GeoLocation> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationEvaluation>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#informs> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationStrategy>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/isAkeyword> ;
    owl:hasSelf true
  ] ;
  dc:description "Active interpretative processes and methodologies for evaluating wildlife for purposes of conservation, typically referring to populations. May or may no be related to genomics-informed assessments" ;
  owl:sameAs "genomics-informed conservation approaches" ;
  skos:altLabel "Genomics Applications" .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationGenomicsProcess> a owl:Class .
<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationManager>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/Consumers>, [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#isRepresentativeOf> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#NationalMarineConservationArea>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#isRepresentativeOf> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#ProvincialPark>
  ] ;
  skos:altLabel "ConservationBiologist", "ConservationScientist", "ConservationZoologist", "Wildlife Biiologist", "Zoologist" .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationPolicy>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationPolicyFramework> ;
  skos:related "policy" .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationPolicyFramework>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture//ConservationFrameworks>, [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/isInformedBy> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/#Inuit_Qaujimajatugangit>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/isInformedBy> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/#SocialEcology>
  ] ;
  dc:description "Conservation Policy refers to nature or wildlife conservation, management or stewardship policies. This includes governmental or organizational strategies aimed at protecting natural areas and species through measures such as land acquisition, management planning, and incentivizing ownership changes within protected areas, as well as governmental, organizational, Indigenous, or other bodies." ;
  rdfs:label "Conservation Policy Frameworks" .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationStrategy>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#informs> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationEvaluation>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/isAkeyword> ;
    owl:hasSelf true
  ] .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/Consumers>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/Roles>, [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#makesAssessmentsOf> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationEvaluation>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#makesAssessmentsOf> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationGenomicsProcess>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#makesAssessmentsOf> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationStrategy>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/collaborativelyImplements> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationStrategy>
  ] ;
  dc:description "An actor (e.g., researcher, application, or system) that uses the CEBP data, systems, tools, and ontologies to gain insights, build other systems, or work toward conservation, stewardship, and/or genomics-informed interventions for the flourishing of species diversity, biodiversity, and socio-ecological systems." ;
  rdfs:label "Consumer" .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ContentTranslation>
  a owl:Class ;
  rdfs:subClassOf <http://w3id.org/vcb/fel#MetaphoricReference> ;
  rdfs:comment "Class to categorize resources for the Science Translator site page." .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/Elder>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/IndigenousPartners> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/Environment> a owl:Class .
<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/EnvironmentalGovernance>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationPolicyFramework> ;
  rdfs:comment """Environmental governance: Broadening ontological spaces for a more livable world
DePuy et al., 2021
"By examining the ontological underpinnings of three environmental governance domains (land, water, biodiversity), we find that dominant contemporary environmental governance concepts and policy instruments are grounded in a modernist ontology which actively shapes the world, making certain aspects and relationships visible while invisibilizing others...In particular, we examine what taking seriously the right to self-determination enshrined in the United Nations Declaration on the Rights of Indigenous Peoples (UNDRIP) could mean for acknowledging Indigenous ontologies as systems of governance in their own right; what challenges and opportunities exist for recognizing and translating ontologies across socio-legal regimes; and how embracing the dynamism and hybridity of ontologies might complicate or advance struggles for material and cognitive justice."

https://doi.org/10.1177/25148486211018565""" ;
  rdfs:label "Environmental Governance" .

