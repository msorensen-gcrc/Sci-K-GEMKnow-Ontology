  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/ConservationPolicyFramework> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#FirstNationsCommunities>
  a owl:Class ;
  rdfs:subClassOf <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/IndigenousCommunity>, [
    a owl:Restriction ;
    owl:onProperty <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#isRepresentativeOf> ;
    owl:someValuesFrom <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/IndigenousTerritory>
  ] .

