[]
  a owl:Axiom ;
  owl:annotatedSource <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture#http://purl.org/dc/terms/rightsHolder> ;
  owl:annotatedProperty skos:definition ;
  owl:annotatedTarget """This term refers to the fact that Indigenous Peoples are “rights and title holders.”
Indigenous Peoples’ constitutionally protected rights allow them to bind up a project in a legal process.
Indigenous communities are not mere stakeholders, they are rights-holders.""" ;
  dc:source "https://ipcaknowledgebasket.ca/resources/glossary/#" .

