cebp:affects a owl:ObjectProperty ;
  rdfs:label "affects"@en ;
  rdfs:comment "" ; #NEEDS COMMENT!!
  # SHACL-MAP: ConservationFramework->Environment; ConservationFramework->SocialEcology;
  #            ConservationPolicyFramework->Environment; ConservationPolicyFramework->Species;
  #            ConservationPolicyFramework->SocialEcology (all v21)
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:ConservationFramework cebp:ConservationPolicyFramework )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:Environment cebp:SocialEcology cebp:Species )
  ] .

cebp:isFoundIn a owl:ObjectProperty ;
  rdfs:label "is found in"@en ;
  rdfs:comment "" ; #NEEDS COMMENT!!
  # SHACL-MAP: Species->Location (v21)
  rdfs:domain cebp:Species ;
  rdfs:range cebp:Location .

cebp:isTiedTo a owl:ObjectProperty ;
  rdfs:label "is tied to"@en ;
  rdfs:comment "" ; #NEEDS COMMENT!!
  # SHACL-MAP: SocialEcology->Location; Location->Environment (all v21)
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:SocialEcology cebp:Location )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:Location cebp:Environment )
  ] .

cebp:isConnectedTo a owl:ObjectProperty ;
  rdfs:label "is connected to"@en ;
  rdfs:comment "Shows a connection between Concept A and Concept B that is not causal, is-a, or part-of, but should be considered as exerting influence or having an effect one on the other."@en ;
  # SHACL-MAP: Environment->SocialEcology; GenomicsMethod->ConservationStrategy;
  #            GenomicsTerm->ConservationStrategy; Species->SocialEcology (all v21)
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:Environment cebp:GenomicsMethod cebp:GenomicsTerm cebp:Species )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:SocialEcology cebp:ConservationStrategy )
  ] .

cebp:relatesTo a owl:ObjectProperty ;
  rdfs:label "relates to"@en ;
  rdfs:comment "" ; #NEEDS COMMENT!!
  # SHACL-MAP: GenomicsMethod->Species; Resource->GenomicsMethod; Resource->Species (all v21)
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:GenomicsMethod cebp:Resource )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:Species cebp:GenomicsMethod )
  ] .
