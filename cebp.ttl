cebp:Maligait a owl:Class ;
  rdfs:label "Maligait"@en ;
  rdfs:comment "Inuit Elders in Nunavut have identified a framework for Inuit Qaujimajatuqangit grounded in four big laws or maligait. All cultural beliefs and values are associated with the implementation of these maligait, ultimately contributing to \"living a good life\", described as the purpose of being."@en ;
  rdfs:subClassOf cebp:InuitQaujimajatugangit ;
  dcterms:source "Government of Nunavut, Department of Culture, Language, Elders and Youth. 2007." .

cebp:HolisticFramework a owl:Class ;
  rdfs:label "Holistic Framework"@en ;
  rdfs:comment "An integrated framework to support conditions for effective, sustained, and equitable collaborations across sectors and interests, spanning three key dimensions: holistic worldviews and perspectives, capacity development opportunities, and dedicated structural supports such as funding, resources, and leadership."@en ;
  rdfs:subClassOf cebp:ConservationFramework ;
  dcterms:source "Bowen and Ebi 2015; Meissner et al." .

cebp:CommunityBasedMonitoring a owl:Class ;
  rdfs:label "Community Based Monitoring"@en ;
  rdfs:comment "A process where local citizens and groups work together to track and respond to issues that affect their daily lives, collecting their own data, overseeing local services, and protecting their environment using both traditional knowledge and scientific tools. Within the Canada BioGenome Project and the Arctic Genomics project, community-based monitoring is applied through workshop-reported practices."@en ;
  rdfs:subClassOf cebp:ConservationStrategy .

