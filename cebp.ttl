@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix schema: <http://schema.org/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dwc: <http://rs.tdwg.org/dwc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cebp: <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/> .

<http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/> 
  a owl:Ontology ;
  owl:versionInfo "0.6.0" ;
  owl:versionIRI <http://gcrc.carleton.ca/ontologies/2023/GCRC_CEBP_Genome_Architecture/0.6.0> ;
  dcterms:title "CEBP GEM-Know Ontology"@en ;
  dcterms:description "Conceptual model for the Genomic Environmental Mobilization Knowledge Network (GEM-Know), developed at the Geomatics and Cartographic Research Centre, Carleton University."@en ;
  dcterms:creator "Geomatics and Cartographic Research Centre (GCRC), Carleton University" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:created "2023-01-01"^^xsd:date ;
  dcterms:modified "2026-08-11"^^xsd:date .


# NOTE A LOT OF THINGS NEED RDFS:LABEL and COMMENT!!!!
cebp:equivalentNERterm a owl:AnnotationProperty . 
cebp:exampleTextSnippet a owl:AnnotationProperty . 
cebp:implementationChallengesAssociatedCosts a owl:AnnotationProperty . 
cebp:layDescription a owl:AnnotationProperty . 
cebp:personalCommunication a owl:AnnotationProperty . 
cebp:relatedQuestions a owl:AnnotationProperty . 
cebp:useCaseText a owl:AnnotationProperty . 
cebp:implementationChallengesDisadvantages a owl:AnnotationProperty . 
cebp:implementationChallengesUseScenario a owl:AnnotationProperty . 
cebp:implementationChallengesWhatMeasured a owl:AnnotationProperty . 
# EVERYTHING BELOW NEEDS A LABEL AND COMMENT
# Domain/range below were aggregated from owl:Restriction blocks that previously
# lived on individual class declarations. Each property carries a SHACL-MAP note
# recording the original per-class pairings so they can be enforced precisely in
# shapes/cebp-shapes.ttl. The aggregated owl:unionOf domain/range is documentation
# only (per STYLE.md); it does not enforce the specific pairings.

cebp:hasMetaphor a owl:ObjectProperty ;
  rdfs:label "has metaphor"@en ;
  rdfs:comment ""@en . #NEEDS COMMENT!!

cebp:informs
  a owl:ObjectProperty ;
  rdfs:label "informs" ;
  rdfs:comment "Links two concepts where concept A actively informs concept B. For example, 'qualitative analysis informs local policy.'" ;
  owl:inverseOf cebp:isInformedBy ;
  # SHACL-MAP: ConservationEvaluation->ConservationStrategy; ConservationStrategy->ConservationEvaluation;
  #            InuitQaujimajatugangit->ConservationStrategy; SocialEcology->EnvironmentalGovernance;
  #            Actor->ConservationPolicyFramework;
  #            ConservationStrategy->ConservationFramework (v21);
  #            IndigenousConservationConcept->ConservationStrategy (v21);
  #            IndigenousConservationConcept->SocialEcology (v21);
  #            SocialEcology->CommunityBasedMonitoring (v21);
  #            Actor->ConservationFramework (v21)
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:ConservationEvaluation cebp:ConservationStrategy cebp:InuitQaujimajatugangit cebp:SocialEcology cebp:Actor cebp:IndigenousConservationConcept )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:ConservationStrategy cebp:ConservationEvaluation cebp:EnvironmentalGovernance cebp:ConservationPolicyFramework cebp:ConservationFramework cebp:SocialEcology cebp:CommunityBasedMonitoring )
  ] .

cebp:isApplicationOf
  a owl:ObjectProperty ;
  rdfs:label "is application of"@en ;
  rdfs:comment "Demonstrates an explicit real life use case of Concept B through Concept A. For example, 'whole genome sequencing is (an) application of SNP.'"@en ; #This may need to be double checked. Also I'm not entirely sure the domain is right for the name of this object property/predicate.
  # SHACL-MAP: GenomicsMethod->GenomicsTool
  rdfs:domain cebp:GenomicsMethod ;
  rdfs:range cebp:GenomicsTool .

cebp:isProvidedBy
  a owl:ObjectProperty ;
  rdfs:label "is provided by"@en ;
  rdfs:comment "Shows who/what (Concept B) hosts the service of Concept A. In our cases it's just showing who is publishing Online Genomic Courses - but could get expanded for other uses. For example, 'Threatened Species Initiative is provided by Bioplatforms Australia.'"@en ;
  owl:inverseOf cebp:provides ;
  # SHACL-MAP: OnlineGenomicsCourse->ThreatenedSpeciesInitiative (was an owl:hasValue restriction
  #            naming a specific individual; the individual ThreatenedSpeciesInitiative MUST BE PUT
  #            INTO NEO4J as instance data, and the OnlineGenomicsCourse->isProvidedBy link asserted there)
  rdfs:domain cebp:OnlineGenomicsCourse .

cebp:isRepresentativeOf a owl:ObjectProperty ;
  rdfs:label "is representative of"@en ;
  rdfs:comment "Connects a group or an individual (Concept A) with the larger group or organization (Concept B) that they speak on behalf of. For example 'Christy the conservation manager is (the) representative of Algonquin Park.'"@en ;
  # SHACL-MAP: FirstNationsCommunity->IndigenousTerritory; IndigenousCouncil->IndigenousTerritory;
  #            ConservationManager->NationalMarineConservationArea; ConservationManager->ProvincialPark;
  #            ConservationManager->ParksCanada (v21)
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:FirstNationsCommunity cebp:ConservationManager cebp:IndigenousCouncil) 
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:IndigenousTerritory cebp:NationalMarineConservationArea cebp:ProvincialPark cebp:ParksCanada ) 
  ] .

cebp:makesAssessmentsOf
  a owl:ObjectProperty ;
  # SHACL-MAP: Consumer->ConservationEvaluation; Consumer->ConservationGenomicsProcess;
  #            Consumer->ConservationStrategy; Producer->SpeciesGenomicsData
  rdfs:label "makes assessments of"@en ;
  rdfs:comment "Declares Concept A as the person or group who is evaluating Concept B. For example, 'Mako the consumer makes assessment of habitat restoration.'"@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:Consumer cebp:Producer )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:ConservationEvaluation cebp:ConservationGenomicsProcess cebp:ConservationStrategy cebp:SpeciesGenomicsData )
  ] .

cebp:collaborativelyImplements
  a owl:ObjectProperty ;
  # SHACL-MAP: Consumer->ConservationStrategy; Producer->ConservationStrategy; WorkingGroup->ConservationStrategy
  rdfs:label "collaboratively implements"@en ;
  rdfs:comment "Declares Concept A as the person or group that is contributing to carrying out Concept B. For example, 'The GCRC collaboratively implements habitat restoration.'"@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:Consumer cebp:Producer cebp:WorkingGroup )
  ] ;
  rdfs:range cebp:ConservationStrategy .

cebp:describes
  a owl:ObjectProperty ;
  # SHACL-MAP: DataProcessingAndEducation->GenomicsMethod; DataProcessingAndEducation->GenomicsTerm
  rdfs:label "describes"@en ;
  rdfs:comment "Declares Concept A as the thing that explains and/or gives context for Concept B. For example, 'Christy describes SNP.'"@en ;
  rdfs:domain cebp:DataProcessingAndEducation ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:GenomicsMethod cebp:GenomicsTerm )
  ] .

cebp:hasExpertise a owl:ObjectProperty ;
  rdfs:label "has expertise"@en ;
  rdfs:comment "Declares person A as having knowledge and/or experience in Concept B. For example, 'Mako has expertise (in) habitat renewal.'"@en ;
  rdfs:domain cebp:Actor . #TO DO will add the range for the this property later.

cebp:hasKeyword
  a owl:ObjectProperty ;
  # SHACL-MAP: IndigenousPersonaResource->SocialEcology; Resource->ConservationStrategy;
  #            Resource->GenomicsMethod; Resource->GenomicsTerm
  rdfs:label "has keyword"@en ;
  rdfs:comment "Declares Concept A as having a term that is a type of Concept B. For example, '(The) 2024 Muskox Report has keyword qPCR.'"@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:IndigenousPersonaResource cebp:Resource )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:SocialEcology cebp:ConservationStrategy cebp:GenomicsMethod cebp:GenomicsTerm )
  ] .
cebp:hasLocation a owl:ObjectProperty ;
  rdfs:label "has location"@en ;
  rdfs:comment "Declares Concept A as being found in the region identified by Concept B. For example, 'Algonquin Park has location 45.8372° N, 78.3791° W.'"@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:ProvincialPark cebp:IndigenousCommunity )
  ] . # I think this property needs to be clarified for me

cebp:hasRole a owl:ObjectProperty ;
  rdfs:label "has role"@en ;
  rdfs:comment "Declares Concept A as having the job/responsibility of Concept B. For example, 'Mako has role Software Developer.'"@en ;
  # SHACL-MAP: foaf:Person->Role (v21)
  rdfs:domain foaf:Person ;
  rdfs:range cebp:Role .

# TODO STEP 7: cebp:isA collides conceptually with rdf:type and must be resolved
# (either removed in favour of rdf:type or renamed to a domain-specific term).
cebp:isA
  a owl:ObjectProperty, owl:TransitiveProperty ;
  # SHACL-MAP: Researcher->GenomicsExpert
  rdfs:label "is a"@en ;
  rdfs:comment "Declares Concept A as being a type of Concept B. For example, 'Christy is a Genomics Expert.'"@en ; #This makes me think that Genomics Expert may not make sense to be a role in and of itself... not sure though.
  rdfs:domain cebp:Researcher ;
  rdfs:range cebp:GenomicsExpert . 

cebp:isAkeyword a owl:ObjectProperty ;
  rdfs:label "is a keyword"@en ;
  rdfs:comment "Identifies Concept A as being a keyword. For example, 'qPCR is a keyword.'"@en . #Not sure if this needs to be in the ontology since this seems more like a Class attribution.

cebp:isInformedBy
  a owl:ObjectProperty ;
  # SHACL-MAP: OnlineGenomicsCourse->GenomicsMethod; ConservationPolicyFramework->InuitQaujimajatugangit;
  #            ConservationPolicyFramework->SocialEcology; GenomicsMethod->OnlineGenomicsCourse;
  #            CollaborativeConservationFramework->InuitQaujimajatugangit;
  #            CollaborativeConservationFramework->SocialEcology
  rdfs:label "is informed by"@en ;
  rdfs:comment "This is the opposite of the object property cebp:informs. Identifies two concepts where Concept A is actively explained by or  concept B. For example, 'local policy is informed by local policy.'"@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:OnlineGenomicsCourse cebp:ConservationPolicyFramework cebp:GenomicsMethod cebp:CollaborativeConservationFramework )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:GenomicsMethod cebp:InuitQaujimajatugangit cebp:SocialEcology cebp:OnlineGenomicsCourse )
  ] .
cebp:isMeasuredBy a owl:ObjectProperty ;
  rdfs:label "is measured by"@en ;
  rdfs:comment "Defines Concept A as something that is being observed or calculated by Concept B."@en ;
  rdfs:domain cebp:BiogenomeDataAndProcess ;
  rdfs:range cebp:GenomicsTool .

cebp:isPartOf
  a owl:ObjectProperty, owl:TransitiveProperty ;
  rdfs:label "is part of"@en ;
  rdfs:comment "Indicates that Concept A belongs to the larger or broader group/category which is Concept B. For example, 'Mako is part of GCRC.'"@en ; 
  # SHACL-MAP: ExSituBiologist->WorkingGroup; GenomicsMethod->ConservationStrategy;
  #            SubsistencePractice->HistoricalRelationshipWithLand (added from June30 Christy version);
  #            Environment->SocialEcology (v21); Species->ConservationStrategy (v21);
  #            Species->SocialEcology (v21); Actor->SocialEcology (v21)
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:ExSituBiologist cebp:GenomicsMethod cebp:SubsistencePractice cebp:Environment cebp:Species cebp:Actor )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:WorkingGroup cebp:ConservationStrategy cebp:HistoricalRelationshipWithLand cebp:SocialEcology )
  ] .

cebp:isUsefulFor a owl:ObjectProperty ;
  rdfs:label "is useful for"@en ;
  rdfs:comment "Indicates that Concept A is well suited for Concept B. For example, 'qPCR is useful for whole genome sequencing.'"@en ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf ( cebp:ConservationStrategy cebp:GenomicsMethod cebp:GenomicsTool )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:ConservationEvaluation cebp:BiogenomeDataAndProcess ) 
  ] .

cebp:occurrenceDeterminedBy a owl:ObjectProperty ;
  rdfs:label "occurrence determined by"@en ;
  rdfs:comment "Indicates that Concept B is the origin for Concept A. For example, 'warmer winters (is an) occurrence determined by climate change.'"@en ;
  rdfs:domain [ 
    a owl:Class ;
    owl:unionOf ( cebp:Species cebp:BiogenomeDataAndProcess cebp:Environment )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( cebp:ConservationStrategy cebp:GenomicsMethod)
  ] .

cebp:provides
  a owl:ObjectProperty ;
  rdfs:label "provides"@en ;
  rdfs:comment "Indicates that Concept A gives necessary data and/or information to Concept B. For example, 'SNP provides whole genome sequencing.'"@en ; 
  # SHACL-MAP: BiogenomeDataAndProcess->ReferenceGenome
  rdfs:domain cebp:BiogenomeDataAndProcess ;
  rdfs:range cebp:ReferenceGenome .

cebp:translatedAs a owl:ObjectProperty ;
  rdfs:label "translated as"@en ;
  rdfs:comment "Used to indicate a translation between Concept A and Concept B. For example, 'Muskox (is) translated as Umingmak (in Inuktitut).'"@en .

cebp:usedToAssess a owl:ObjectProperty ;
  rdfs:label "used to assess"@en ;
  rdfs:comment "Indicates Concept A is a method to validate Concept B. For example, 'water temperature (is) used to assess climate change.'"@en ;
  rdfs:domain cebp:GenomicsTool ;
  rdfs:range cebp:GenomicsMethod .

cebp:isExampleOf a owl:ObjectProperty ;
  rdfs:label "is example of"@en ;
  rdfs:comment "Indicates that Concept A is a type/demonstration of Concept B. For example, 'Arctic Char is example of Indigenous Food Sovereignty.'"@en .

cebp:ClimateChangePolicy
  a owl:Class ;
  rdfs:label "Climate Change Policy"@en ;
  rdfs:subClassOf cebp:ConservationPolicyFramework ;
  rdfs:comment ""@en . #NEEDS COMMENT!!

cebp:FirstNationsCommunity a owl:Class ;
  rdfs:label "First Nations Community"@en ; 
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:IndigenousCommunity .


cebp:GenomicsTrainingResource
  a owl:Class ;
  rdfs:label "Genomics Training Resource"@en ;
  rdfs:comment ""@en ;
  rdfs:subClassOf cebp:DataProcessingAndEducation .

cebp:NationalMarineConservationArea
  a owl:Class ;
  rdfs:label "National Marine Conservation Area"@en ;
  rdfs:comment ""@en ;
  rdfs:subClassOf cebp:Geolocation .

cebp:NorthernIndigenousCommunity # Changed the spelling from Indigneous to proper spelling of Indigenous.
  a owl:Class ;
  rdfs:label "Northern Indigenous Community"@en ;
  rdfs:comment ""@en ;
  rdfs:subClassOf cebp:IndigenousCommunity .

cebp:OnlineGenomicsCourse
  a owl:Class ;
  rdfs:label "Online Genomics Course"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:GenomicsTool .

cebp:ProvincialPark
  a owl:Class ;
  rdfs:label "Provincial Park"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:Geolocation .

cebp:RightsHolder
  a owl:Class ;
  rdfs:subClassOf cebp:IndigenousPartner ;
  rdfs:label "Rights Holder"@en ;
  skos:definition """This term refers to the fact that Indigenous Peoples are “rights and title holders.”
Indigenous Peoples’ constitutionally protected rights allow them to bind up a project in a legal process.
Indigenous communities are not mere stakeholders, they are rights-holders.""" .

cebp:AcademicInstitution
  a owl:Class ;
  rdfs:label "Academic Institution"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:Producer .

cebp:BiogenomeDataAndProcess
  a owl:Class ;
  rdfs:label "Biogenome Data And Process"@en ;
  rdfs:comment "Canada BioGenome Project (www.biogenome.ca), which has the aim of producing annotated genomes for approximately 400 Canadian species that are of cultural, conservation, scientific, and/or economic significance. Having a reference genome available increases the opportunities to incorporate genomic data into Species conservation."@en .


cebp:CommitteeMember
  a owl:Class ;
  rdfs:label "Committee Member"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf foaf:Person . # Changed from old outdated Person class to foaf class

cebp:CommunityScholar
  a owl:Class ;
  rdfs:label "Community Scholar"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:IndigenousPartner .

cebp:Company
  a owl:Class ;
  rdfs:subClassOf cebp:Consumer, cebp:Actor ;
  rdfs:comment "An Actor that is neither a Consumer nor Producer, but a grop, typically for-proft, working toward conservation, stewardship, and/or genomics-informed interventions for the flourishing of species diversity, biodiversity, and socio-ecological systems."@en ;
  rdfs:label "Company" .

cebp:ConservationArea
  a owl:Class ;
  rdfs:label "Conservation Area"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:Geolocation .

cebp:ConservationEvaluation
  a owl:Class ;
  rdfs:label "Conservation Evaluation"@en ;
  rdfs:comment "Active interpretative processes and methodologies for evaluating wildlife for purposes of conservation, typically referring to populations. May or may no be related to genomics-informed assessments"@en ;
  # owl:sameAs "genomics-informed conservation approaches" ; Don't really know what this is supposed to be - owl:sameAs should be connecting IRIs not text.
  skos:altLabel "Genomics Application" .

cebp:ConservationManager a owl:Class ;
  rdfs:label "Conservation Manager"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:Consumer ;
  skos:altLabel "ConservationBiologist", "ConservationScientist", "ConservationZoologist", "Wildlife Biiologist", "Zoologist" .

cebp:ConservationPolicy
  a owl:Class ;
  rdfs:label "Conservation Policy"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:ConservationPolicyFramework ;
  skos:related "policy" .

cebp:ConservationPolicyFramework
  a owl:Class ;
  rdfs:label "Conservation Policy Framework"@en ;
  rdfs:subClassOf cebp:ConservationFramework ;
  rdfs:comment "Conservation Policy refers to nature or wildlife conservation, management or stewardship policies. This includes governmental or organizational strategies aimed at protecting natural areas and species through measures such as land acquisition, management planning, and incentivizing ownership changes within protected areas, as well as governmental, organizational, Indigenous, or other bodies."@en .

cebp:ConservationStrategy
  a owl:Class ;
  rdfs:label "Conservation Strategy"@en ;
  rdfs:comment ""@en . #NEEDS COMMENT!!

cebp:Consumer
  a owl:Class ;
  rdfs:subClassOf cebp:Role ;
  rdfs:comment "An actor (e.g., researcher, application, or system) that uses the CEBP data, systems, tools, and ontologies to gain insights, build other systems, or work toward conservation, stewardship, and/or genomics-informed interventions for the flourishing of species diversity, biodiversity, and socio-ecological systems."@en ;
  rdfs:label "Consumer"@en .

cebp:ContentTranslation
  a owl:Class ;
  rdfs:label "Content Translation"@en ;
  rdfs:subClassOf <http://w3id.org/vcb/fel#MetaphoricReference> ;
  rdfs:comment "Class to categorize resources for the Science Translator site page." .

cebp:Elder
  a owl:Class ;
  rdfs:label "Elder"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:IndigenousPartner .

cebp:Environment a owl:Class ;
  rdfs:label "Environment"@en ;
  rdfs:comment ""@en . #NEEDS COMMENT!!

cebp:EnvironmentalGovernance
  a owl:Class ;
  rdfs:subClassOf cebp:ConservationPolicyFramework ;
  rdfs:comment """Environmental governance: Broadening ontological spaces for a more livable world
DePuy et al., 2021
"By examining the ontological underpinnings of three environmental governance domains (land, water, biodiversity), we find that dominant contemporary environmental governance concepts and policy instruments are grounded in a modernist ontology which actively shapes the world, making certain aspects and relationships visible while invisibilizing others...In particular, we examine what taking seriously the right to self-determination enshrined in the United Nations Declaration on the Rights of Indigenous Peoples (UNDRIP) could mean for acknowledging Indigenous ontologies as systems of governance in their own right; what challenges and opportunities exist for recognizing and translating ontologies across socio-legal regimes; and how embracing the dynamism and hybridity of ontologies might complicate or advance struggles for material and cognitive justice."

https://doi.org/10.1177/25148486211018565"""@en ;
  rdfs:label "Environmental Governance" .

cebp:ExSituBiologist
  a owl:Class ;
  rdfs:label "Ex-Situ Biologist"@en ;
  rdfs:comment ""@en ; #NEEDS COMMENT!!
  rdfs:subClassOf cebp:Producer .

cebp:GenomicsDataValidation 
  a owl:Class ;
